#!/usr/bin/perl

use strict;
use warnings;
use Errno qw(EACCES EPERM EINTR);
use Fcntl qw(O_CREAT O_EXCL O_WRONLY);
use POSIX qw(WIFEXITED WEXITSTATUS WIFSIGNALED WTERMSIG setpgid setsid);
use Time::HiRes qw(sleep clock_gettime CLOCK_MONOTONIC);

sub process_fields {
  my ($pid) = @_;
  open my $handle, "<", "/proc/$pid/stat" or return;
  my $line = <$handle>;
  close $handle;
  return unless defined $line;
  my $end = rindex($line, ") ");
  return if $end < 0;
  my @fields = split /\s+/, substr($line, $end + 2);
  return @fields;
}

sub process_is_live {
  my ($pid, $expected_start) = @_;
  my @fields = process_fields($pid);
  return @fields >= 20 && $fields[0] ne "Z" && $fields[19] eq $expected_start;
}

sub child_is_zombie {
  my ($pid) = @_;
  my @fields = process_fields($pid);
  return @fields && $fields[0] eq "Z";
}

sub duration_seconds {
  my ($text) = @_;
  return unless $text =~ /\A([0-9]*\.?[0-9]+)([smhd]?)\z/;
  my %scale = ("" => 1, s => 1, m => 60, h => 3600, d => 86400);
  return $1 * $scale{$2};
}

my $runner_pid = shift // die "Missing runner PID\n";
my $runner_start = shift // die "Missing runner start time\n";
my $control_dir = shift // die "Missing control directory\n";
my $duration = shift // die "Missing timeout duration\n";
die "Missing --capture\n" unless (shift // "") eq "--capture";
my $capture_mode = shift // "";
my $capture_limit = shift // "";
my $output_path = shift // "";
die "Invalid capture mode or limit\n"
  unless $capture_mode =~ /\A(?:head|tail)\z/
    && $capture_limit =~ /\A[0-9]+\z/ && $capture_limit > 0 && $capture_limit <= 1048576;
die "Invalid runner identity\n" unless $runner_pid =~ /\A[0-9]+\z/ && $runner_start =~ /\A[0-9]+\z/;
die "Invalid control directory\n" unless $control_dir =~ m{\A/} && $control_dir !~ /\0/;
my $deadline_seconds = duration_seconds($duration);
die "Invalid timeout duration\n" unless defined($deadline_seconds) && $deadline_seconds > 0;
die "Missing command separator\n" unless (shift // "") eq "--";
die "Missing action command\n" unless @ARGV;
open my $capture_output, ">", $output_path or die "Could not open capture output: $!\n";
binmode $capture_output;
pipe(my $capture_read, my $capture_write) or die "Could not create capture pipe: $!\n";

# The runner reads this advisory line to tell its own timeout apart from an
# action that was killed or exited with a timeout-like status. Failing to
# write it (for example ENOSPC) never changes the action's result.
sub report_outcome {
  my ($outcome) = @_;
  sysopen(my $handle, "$control_dir/outcome", O_WRONLY | O_CREAT | O_EXCL, 0600) or return;
  print {$handle} "$outcome\n";
  close $handle;
}

sub finish_with_status {
  my ($status, $started) = @_;
  my $elapsed = clock_gettime(CLOCK_MONOTONIC) - $started;
  my $timed_out = $elapsed >= $deadline_seconds
    && ((WIFEXITED($status) && WEXITSTATUS($status) == 124)
      || (WIFSIGNALED($status) && WTERMSIG($status) == 9));
  if ($timed_out) {
    report_outcome("timeout");
  } elsif (WIFSIGNALED($status)) {
    report_outcome("signal " . WTERMSIG($status));
  } elsif (WIFEXITED($status)) {
    report_outcome("exit " . WEXITSTATUS($status));
  }
  exit WEXITSTATUS($status) if WIFEXITED($status);
  exit 128 + WTERMSIG($status) if WIFSIGNALED($status);
  report_outcome("internal");
  exit 125;
}

sub fail_internal {
  report_outcome("internal");
  exit 125;
}

setsid() >= 0 or die "Could not detach action supervisor: $!\n";
$SIG{CHLD} = "DEFAULT";
my $stop_requested = 0;
$SIG{HUP} = $SIG{INT} = $SIG{TERM} = sub { $stop_requested = 1 };

my $started = clock_gettime(CLOCK_MONOTONIC);
my $child = fork();
die "Could not fork action timeout: $!\n" unless defined $child;
if ($child == 0) {
  $SIG{HUP} = $SIG{INT} = $SIG{TERM} = "DEFAULT";
  close $capture_read;
  close $capture_output;
  open STDOUT, ">&", $capture_write or POSIX::_exit(126);
  open STDERR, ">&", $capture_write or POSIX::_exit(126);
  close $capture_write;
  # stdin belongs to the runner's cancellation pipe, never to the action.
  open STDIN, "<", "/dev/null" or POSIX::_exit(126);
  # Actions receive only stdin/stdout/stderr. The runner's locks, coproc
  # pipes and any other inherited descriptor must not reach the action tree.
  opendir(my $descriptors, "/proc/self/fd") or POSIX::_exit(126);
  my @inherited = grep { /\A[0-9]+\z/ && $_ > 2 } readdir($descriptors);
  my $listing = fileno($descriptors);
  closedir $descriptors;
  POSIX::close($_) for grep { $_ != $listing } @inherited;
  setpgid(0, 0) or POSIX::_exit(126);
  exec({"/usr/bin/timeout"} "/usr/bin/timeout", "--kill-after=1s", "--", $duration,
    "/usr/bin/bash", "-c", 'exec -- "$@"', "bash", @ARGV)
    or POSIX::_exit(126);
}
close $capture_write;

# Only the timeout group owns the capture pipe. Keeping another writer in the
# supervisor would make a completed action look like it leaked stdout.
# Establish the group before relying on group signals. The child performs the
# same operation, so EACCES here only means it already crossed exec safely.
if (!setpgid($child, $child) && $! != EACCES && $! != EPERM) {
  kill "KILL", $child;
  waitpid($child, 0);
  fail_internal();
}
if (!open(STDOUT, ">", "/dev/null") || !open(STDERR, ">", "/dev/null")) {
  kill "KILL", -$child;
  waitpid($child, 0);
  fail_internal();
}

# Capture and process lifetime have one native owner. In particular there is
# no Bash-owned head/tail child whose PID could be reaped before a later kill.
# Keep the timeout leader unreaped until the final possible group signal.
my $buffer = "";
my $output_eof = 0;
my $exited_at;
my $capture_error = 0;
my $cancelled = 0;
while (1) {
  $stop_requested = 1 unless process_is_live($runner_pid, $runner_start);
  if ($stop_requested) {
    $cancelled = 1 unless $capture_error;
    kill "TERM", -$child;
    sleep 0.05;
    kill "KILL", -$child;
    last;
  }

  my $readers = "";
  vec($readers, fileno(STDIN), 1) = 1;
  vec($readers, fileno($capture_read), 1) = 1 unless $output_eof;
  my $ready = select(my $available = $readers, undef, undef, 0.01);
  if (!defined($ready) || $ready < 0) {
    next if $! == EINTR;
    $capture_error = $stop_requested = 1;
    next;
  }
  if (vec($available, fileno(STDIN), 1)) {
    my $read = sysread(STDIN, my $control, 1);
    # Closing the runner's pipe cancels even if its filesystem is full or
    # the control directory has disappeared. No recyclable PID is signaled.
    $stop_requested = 1 if !defined($read) || $read == 0 || $control ne "";
  }
  if (!$output_eof && vec($available, fileno($capture_read), 1)) {
    my $read = sysread($capture_read, my $chunk, 8192);
    if (!defined $read) {
      next if $! == EINTR;
      $capture_error = $stop_requested = 1;
    } elsif ($read == 0) {
      $output_eof = 1;
    } elsif ($capture_mode eq "head") {
      $buffer .= substr($chunk, 0, $capture_limit + 1 - length($buffer));
      $capture_error = $stop_requested = 1 if length($buffer) > $capture_limit;
    } else {
      $buffer .= $chunk;
      substr($buffer, 0, length($buffer) - $capture_limit, "")
        if length($buffer) > $capture_limit;
    }
  }
  next if $stop_requested;
  if (child_is_zombie($child)) {
    $exited_at //= clock_gettime(CLOCK_MONOTONIC);
    last if $output_eof;
    # Preserve intentional detached children that close capture, but stop
    # ordinary descendants that keep the pipe open after the action exits.
    $stop_requested = 1 if clock_gettime(CLOCK_MONOTONIC) - $exited_at >= 0.1;
  }
}
close $capture_read;
my $waited = waitpid($child, 0);
my $status = $?;
$capture_error = 1 if $waited != $child;
my $offset = 0;
while ($offset < length($buffer)) {
  my $written = syswrite($capture_output, $buffer, length($buffer) - $offset, $offset);
  if (!defined($written) || $written == 0) {
    next if !defined($written) && $! == EINTR;
    $capture_error = 1;
    last;
  }
  $offset += $written;
}
$capture_error = 1 unless close $capture_output;
fail_internal() if $capture_error;
report_outcome("cancelled") if $cancelled && !defined $exited_at;
finish_with_status($status, $started);
