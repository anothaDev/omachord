#!/bin/bash
# Runner stand-in for the watchdog fixtures (service-hang.qml, panel-hang.qml).
# A command hangs while "$OMACHORD_QML_TEST_DIR/hang-<command>" exists, and
# also ignores SIGTERM while "ignore-term-<command>" exists, so only the QML
# deadlines can end it. <command> is the first argument, or "config-apply"
# style for the two-word commands. Nothing outside the test dir is touched.
set -euo pipefail

dir=${OMACHORD_QML_TEST_DIR:?}
calls="$dir/hang-calls.log"
export FAKE_UNEXPECTED_LOG="$calls"
source "${BASH_SOURCE[0]%/*}/fake-runner-grammar"
fake_check_argv "$@"

revision=$(fake_revision e)
key=$1
if [[ $key == config || $key == widget ]]; then key="$1-$2"; fi
printf 'START %s\n' "$*" >>"$calls"
if [[ -e $dir/hang-$key ]]; then
  if [[ -e $dir/ignore-term-$key ]]; then trap '' TERM; fi
  printf 'HANG %s\n' "$key" >>"$calls"
  exec sleep 3600
fi

case $key in
  autostart) reply='{"ok":true,"connected":true,"warnings":[]}' ;;
  status) reply='{"ok":true,"connected":true,"ownedConnection":true,"integrationComplete":true,"connectionEnabled":true,"configValid":true,"configError":"","activeCount":0}' ;;
  config-snapshot)
    reply=$(jq -cn --arg revision "$revision" '{ok:true,revision:$revision,committed:true,config:{version:1,routines:[
      {id:"alpha",name:"Alpha",enabled:true,triggers:[],actions:[{type:"delay",milliseconds:0}]}]}}') ;;
  config-apply)
    cat >/dev/null
    reply=$(jq -cn --arg revision "$(fake_revision f)" '{ok:true,connected:true,warnings:[],revision:$revision,deactivated:[]}') ;;
  connect) reply='{"ok":true,"connected":true,"warnings":[]}' ;;
  disconnect) reply='{"ok":true,"connected":false,"deactivated":[]}' ;;
  run|activate) reply=$(jq -cn --arg id "$2" --arg trigger "${3:-manual}" '{ok:true,routineId:$id,trigger:$trigger,durationMs:1}') ;;
  deactivate) reply=$(jq -cn --arg id "$2" --arg trigger "${3:-manual}" '{ok:true,routineId:$id,trigger:$trigger,state:"inactive",alreadyInactive:true}') ;;
  themes) reply='Fixture Theme' ;;
  theme-palette) reply='{"ok":true,"green":"#aabbcc","name":"Fixture Theme"}' ;;
  service-status) reply='{"ready":true,"enabled":true,"routines":[]}' ;;
  active|bindings|commands|logs|toggles) reply='[]' ;;
  widget-ensure) reply='{"ok":true,"placed":false}' ;;
  *) fake_usage "$@" ;;
esac
printf 'END %s\n' "$key" >>"$calls"
printf '%s\n' "$reply"
