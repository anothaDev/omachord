#!/bin/bash
set -euo pipefail
dir=${OMACHORD_QML_TEST_DIR:?}
printf '%s\n' "$*" >>"$dir/calls.log"
export FAKE_UNEXPECTED_LOG="$dir/calls.log"
source "${BASH_SOURCE[0]%/*}/fake-runner-grammar"
fake_check_argv "$@"
revision_a=$(fake_revision a)
revision_c=$(fake_revision c)
case "${1:-} ${2:-}" in
  'config snapshot') jq -cn --arg revision "$revision_a" '{ok:true,committed:true,revision:$revision,config:{version:1,routines:[{id:"alpha",name:"Alpha",enabled:true,triggers:[],actions:[{type:"delay",milliseconds:0}]},{id:"beta",name:"Beta",enabled:true,triggers:[],actions:[]}]}}' ;;
  'config apply') cat >/dev/null; jq -cn --arg revision "$revision_c" '{ok:true,connected:true,warnings:[],revision:$revision,deactivated:[]}' ;;
  'autostart ') printf '{"ok":true,"connected":true,"warnings":[]}\n' ;;
  'status ') printf '{"ok":true,"connected":true,"ownedConnection":true,"integrationComplete":true,"connectionEnabled":true,"configValid":true,"configError":""}\n' ;;
  'run '*|'activate '*)
    if [[ ${4:-} == "$revision_a" ]]; then
      printf '{"ok":false,"code":"stale-config","error":"Fixture changed config"}\n'; exit 1
    fi
    jq -cn --arg id "$2" --arg trigger "${3:-manual}" '{ok:true,routineId:$id,trigger:$trigger,state:"activated",durationMs:1,expiresAt:null}' ;;
  'deactivate '*) jq -cn --arg id "$2" --arg trigger "${3:-manual}" '{ok:true,routineId:$id,trigger:$trigger,state:"deactivated",restored:0,skipped:0,durationMs:1}' ;;
  'theme-palette '*) printf '{"ok":true,"green":"#aabbcc","name":"Fixture Theme"}\n' ;;
  'themes '*) printf 'Fixture Theme\n' ;;
  'service-status '*) printf '{"ready":true,"enabled":true,"routines":[]}\n' ;;
  'active '|'bindings '|'commands '|'toggles '|'logs '*) printf '[]\n' ;;
  'widget ensure') printf '{"ok":true,"placed":false}\n' ;;
  *) fake_usage "$@" ;;
esac
