#!/bin/bash
# Isolated Panel UI fixture. Plans and release gates live only in the test dir.
set -euo pipefail

test_dir=${OMACHORD_QML_TEST_DIR:?}
export FAKE_UNEXPECTED_LOG="$test_dir/transition-calls.log"
source "${BASH_SOURCE[0]%/*}/fake-runner-grammar"
fake_check_argv "$@"
base=$(fake_revision 0)
operation=${1:-}
if [[ $operation = config ]]; then operation="config-${2:-}"; fi
plan="$test_dir/$operation-plan.json"
case $operation in
  status)
    reply='{"ok":true,"connected":false,"ownedConnection":false,"integrationComplete":false,"connectionEnabled":false,"configValid":true}'
    ;;
  config-snapshot)
    reply='{"ok":true,"committed":true,"revision":"'"$base"'","config":{"version":1,"routines":[{"id":"alpha","name":"Alpha","enabled":true,"triggers":[],"actions":[{"type":"dnd","value":true,"restore":true}]},{"id":"beta","name":"Beta","enabled":true,"triggers":[],"actions":[{"type":"dnd","value":true,"restore":true}]}]}}'
    ;;
  config-apply)
    IFS= read -r payload
    jq -e '.version == 1 and (.routines | type == "array")' <<<"$payload" >/dev/null
    reply=$(jq -cn --arg revision "$(fake_revision a)" '{ok:true,connected:false,warnings:[],revision:$revision,deactivated:[]}')
    ;;
  connect) reply=$(jq -cn --arg revision "$(fake_revision c)" '{ok:true,connected:true,repaired:false,warnings:[],revision:$revision}') ;;
  disconnect) reply='{"ok":true,"connected":false,"deactivated":[]}' ;;
  run) reply=$(jq -cn --arg id "$2" --arg trigger "${3:-manual}" '{ok:true,routineId:$id,trigger:$trigger,state:"activated",durationMs:1,expiresAt:null}') ;;
  deactivate) reply=$(jq -cn --arg id "$2" --arg trigger "${3:-manual}" '{ok:true,routineId:$id,trigger:$trigger,state:"deactivated",restored:1,skipped:0,durationMs:1}') ;;
  themes) reply='Fixture Theme' ;;
  service-status) reply='{"ready":true,"enabled":true,"routines":[]}' ;;
  theme-palette) reply='{"ok":true,"green":"#aabbcc","name":"Fixture Theme"}' ;;
  active|bindings|commands|logs|toggles) reply='[]' ;;
  *) fake_usage "$@" ;;
esac

tag=default
exit_code=0
block=false
if [[ -f $plan ]]; then
  # Capture the entire plan before blocking, just as a probe captures a snapshot.
  captured=$(cat -- "$plan")
  tag=$(jq -r '.tag // "default"' <<<"$captured")
  exit_code=$(jq -r '.exitCode // 0' <<<"$captured")
  block=$(jq -r '.block // false' <<<"$captured")
  reply=$(jq -r --arg fallback "$reply" 'if has("raw") then .raw elif has("reply") then (.reply | tojson) else $fallback end' <<<"$captured")
fi
printf '%s START %s %s\n' "$operation" "$tag" "$*" >>"$test_dir/transition-calls.log"
if [[ $block = true ]]; then
  for _ in {1..1000}; do
    [[ -e $test_dir/release-$tag ]] && break
    sleep 0.01
  done
  [[ -e $test_dir/release-$tag ]] || { printf 'Fixture gate timed out: %s\n' "$tag" >&2; exit 1; }
fi
printf '%s\n' "$reply"
printf '%s END %s\n' "$operation" "$tag" >>"$test_dir/transition-calls.log"
exit "$exit_code"
